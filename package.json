{
  "name": "bumeter",
  "displayName": "Bumeter — AI Coding Token Usage (Claude Code, Kiro, OpenCode)",
  "description": "See where your Claude Code, Kiro and OpenCode tokens go: quota and context in the status bar, the costliest conversations and turns, a skill manager, and the files agents keep reading. Read from local logs; nothing leaves your machine.",
  "version": "0.2.1",
  "publisher": "bumkom",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/bumeter/vscode"
  },
  "homepage": "https://bumeter.cc",
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "claude code",
    "claude",
    "kiro",
    "opencode",
    "token usage",
    "usage",
    "quota",
    "rate limit",
    "context",
    "tokens",
    "cost",
    "skills",
    "agent",
    "ai",
    "statusline",
    "anthropic",
    "bumeter"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "bumeter.openOverview",
        "title": "Open Overview",
        "category": "Bumeter"
      },
      {
        "command": "bumeter.refresh",
        "title": "Refresh",
        "category": "Bumeter"
      }
    ],
    "configuration": {
      "title": "Bumeter",
      "properties": {
        "bumeter.binaryPath": {
          "type": "string",
          "default": "",
          "description": "Path to the `bum` command. Empty: the one bundled with the extension, then `bum` on PATH."
        },
        "bumeter.decorations.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Mark files in the Explorer that agents read again and again."
        },
        "bumeter.decorations.minReads": {
          "type": "number",
          "default": 3,
          "minimum": 2,
          "description": "Reads in the last 7 days from which a file is marked."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "media": "node scripts/media.mjs",
    "package": "npm run build && npm run media && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@bumeter/ui": "^1.2.0",
    "@bumeter/vscode-kit": "file:../vscode-kit",
    "@types/node": "^20.0.0",
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  },
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  }
}
